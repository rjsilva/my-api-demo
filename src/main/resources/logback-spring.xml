<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console: structured JSON (format from logging.structured.format.console, ECS) — the primary log
  output. Boot's console-appender.xml is pattern-based, so the appender is declared here with
  Boot's StructuredLogEncoder instead of being included.
  OTEL: the same events exported over OTLP (Loki). The appender is wired to the auto-configured
  OpenTelemetry SDK by OpenTelemetryAppenderInstaller; export is batched and asynchronous.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>${CONSOLE_LOG_STRUCTURED_FORMAT:-ecs}</format>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <!-- request_id (MDC) and the key-value pairs (http.*, error.*, ...) become log attributes. -->
        <captureMdcAttributes>*</captureMdcAttributes>
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureCodeAttributes>false</captureCodeAttributes>
    </appender>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
